@page
@model wt_lab5_5razor_liger.Pages.Teachers.CreateModel

@{
    ViewData["Title"] = "Добавить преподавателя";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">

            <div class="card shadow-sm rounded-4 border-0">
                <div class="card-body p-4">

                    <h2 class="mb-4 text-university">
                        <i class="bi bi-person-plus"></i>
                        Добавление преподавателя
                    </h2>

                    <form method="post">

                        <div class="mb-3">
                            <label asp-for="Teacher.FullName" class="form-label"></label>
                            <input asp-for="Teacher.FullName" class="form-control" />
                            <span asp-validation-for="Teacher.FullName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Teacher.Department" class="form-label"></label>
                            <input asp-for="Teacher.Department" class="form-control" />
                            <span asp-validation-for="Teacher.Department" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Teacher.ExperienceYears" class="form-label"></label>
                            <input asp-for="Teacher.ExperienceYears" class="form-control" type="number" min="0" max="60" />
                            <span asp-validation-for="Teacher.ExperienceYears" class="text-danger"></span>
                        </div>

                        <div class="form-check mb-4">
                            <input asp-for="Teacher.HasDegree" class="form-check-input" />
                            <label asp-for="Teacher.HasDegree" class="form-check-label"></label>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-lg"></i> Сохранить
                            </button>
                            <a asp-page="./Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Назад к списку
                            </a>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}