@page
@model IndexModel
@{
    ViewData["Title"] = "Главная";
}

<div class="container py-4">
    <!-- Hero-блок -->
    <div class="row justify-content-center mb-5">
        <div class="col-lg-10 text-center">
            <img src="~/images/logo.png" alt="Эмблема" height="100" class="mb-4" />
            <h1 class="display-5 fw-bold text-university mb-3">
                Академия управления при Президенте Республики Беларусь
            </h1>
            <p class="lead text-muted mb-4">
                Информационная система управления студентами, преподавателями и курсами
            </p>
        </div>
    </div>

    <!-- Карточки сущностей -->
    <div class="row g-4 justify-content-center">

        <!-- Студенты -->
        <div class="col-12 col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body text-center">
                    <div class="fs-1 text-university mb-3">
                        <i class="bi bi-people-fill"></i>
                    </div>
                    <h5 class="card-title">Студенты</h5>
                    <p class="text-muted small mb-4">
                        Просмотр списка студентов и их успеваемости
                    </p>
                    <a asp-page="/Students/Index" class="btn btn-outline-primary w-100">
                        Перейти
                    </a>
                </div>
            </div>
        </div>

        <!-- Преподаватели -->
        <div class="col-12 col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body text-center">
                    <div class="fs-1 text-university mb-3">
                        <i class="bi bi-person-workspace"></i>
                    </div>
                    <h5 class="card-title">Преподаватели</h5>
                    <p class="text-muted small mb-4">
                        Информация о преподавателях и их стаже
                    </p>
                    <a asp-page="/Teachers/Index" class="btn btn-outline-primary w-100">
                        Перейти
                    </a>
                </div>
            </div>
        </div>

        <!-- Курсы -->
        <div class="col-12 col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body text-center">
                    <div class="fs-1 text-university mb-3">
                        <i class="bi bi-journal-bookmark-fill"></i>
                    </div>
                    <h5 class="card-title">Курсы</h5>
                    <p class="text-muted small mb-4">
                        Учебные дисциплины и их преподаватели
                    </p>
                    <a asp-page="/Courses/Index" class="btn btn-outline-primary w-100">
                        Перейти
                    </a>
                </div>
            </div>
        </div>

    </div>
</div>