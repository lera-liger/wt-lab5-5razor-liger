<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Университет</title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons (для иконок в меню) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Наши стили (шрифты, цвета, hover-эффекты) -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <!-- Bootstrap Navbar -->
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">

                <!-- Логотип и название -->
                <a class="navbar-brand d-flex align-items-center fw-bold text-university" asp-page="/Index">
                    <img src="~/images/logo.png" alt="Эмблема" height="40" class="me-2" />
                    <span>Академия управления при Президенте Республики Беларусь</span>
                </a>

                <!-- Кнопка мобильного меню -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar" aria-controls="mainNavbar"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Основное меню -->
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav ms-auto">

                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/Index">
                                <i class="bi bi-house-door"></i> Главная
                            </a>
                        </li>

                        <!-- Выпадающее меню для сущностей -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#"
                               id="universityDropdown" role="button"
                               data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-mortarboard"></i> Университет
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="universityDropdown">
                                <li>
                                    <a class="dropdown-item" asp-page="/Students/Index">
                                        <i class="bi bi-people me-2"></i> Студенты
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-page="/Teachers/Index">
                                        <i class="bi bi-person-workspace me-2"></i> Преподаватели
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-page="/Courses/Index">
                                        <i class="bi bi-journal-bookmark me-2"></i> Курсы
                                    </a>
                                </li>
                            </ul>
                        </li>

                        <!-- Кнопка добавления (выделяем цветом) -->
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/Students/Create">
                                <i class="bi bi-person-plus"></i> Добавить
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/Privacy">
                                <i class="bi bi-info-circle"></i> О работе
                            </a>
                        </li>

                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Основной контент -->
    <div class="container flex-grow-1">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Подвал -->
    <footer class="border-top footer text-muted mt-5 bg-light">
        <div class="container py-3 d-flex justify-content-between flex-wrap">
            <span>&copy; 2026 — Академия управления при Президенте Республики Беларусь</span>
            <span>Управление информационными ресурсами</span>
        </div>
    </footer>

    <!-- Скрипты -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>