@page
@model wt_lab5_5razor_liger.Pages.Students.CreateModel

@{
    ViewData["Title"] = "Добавить студента";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">

            <div class="card shadow-sm rounded-4 border-0">
                <div class="card-body p-4">

                    <h2 class="mb-4 text-university">
                        <i class="bi bi-person-plus"></i>
                        Добавление студента
                    </h2>

                    <form method="post">

                        <div class="mb-3">
                            <label asp-for="Student.FullName" class="form-label"></label>
                            <input asp-for="Student.FullName" class="form-control" />
                            <span asp-validation-for="Student.FullName" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Student.Course" class="form-label"></label>
                                <input asp-for="Student.Course" class="form-control" type="number" min="1" max="4" />
                                <span asp-validation-for="Student.Course" class="text-danger"></span>
                            </div>
                           
                            <div class="mb-3">
                                <label asp-for="Student.Specialty" class="form-label"></label>
                                <input asp-for="Student.Specialty" class="form-control" />
                                <span asp-validation-for="Student.Specialty" class="text-danger"></span>
                           
                                <div class="col-md-6 mb-3">
                                <label asp-for="Student.AverageGrade" class="form-label"></label>
                                <input asp-for="Student.AverageGrade" class="form-control" type="number" step="0.1" min="0" max="10" />
                                <span asp-validation-for="Student.AverageGrade" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="form-check mb-4">
                            <input asp-for="Student.IsEnrolled" class="form-check-input" />
                            <label asp-for="Student.IsEnrolled" class="form-check-label"></label>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-lg"></i> Сохранить
                            </button>
                            <a asp-page="./Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Назад к списку
                            </a>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}