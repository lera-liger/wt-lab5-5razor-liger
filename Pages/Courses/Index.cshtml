@page
@model wt_lab5_5razor_liger.Pages.Courses.IndexModel

@{
    ViewData["Title"] = "Курсы";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h1 class="fw-bold text-university mb-1">
                <i class="bi bi-journal-bookmark-fill"></i> Курсы
            </h1>
            <p class="text-muted mb-0">Всего: @Model.Courses.Count</p>
        </div>
        <a asp-page="/Courses/Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Добавить курс
        </a>
    </div>

    @if (Model.Courses.Count == 0)
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> Список курсов пуст.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var course in Model.Courses)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm rounded-4 border-0">
                        <div class="card-body d-flex flex-column">

                            <span class="badge bg-secondary mb-2 align-self-start">
                                ID: @course.Id
                            </span>

                            <h5 class="card-title">@course.Title</h5>

                            <p class="text-muted mb-2">
                                <i class="bi bi-calendar3"></i> @course.Semester семестр
                            </p>

                            <p class="mb-3">
                                <i class="bi bi-clock"></i> @course.Hours часов
                            </p>

                            <div class="mt-auto d-flex gap-2">
                                <a asp-page="./Details" asp-route-id="@course.Id"
                                   class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-eye"></i> Подробнее
                                </a>

                                <form method="post" asp-page-handler="Delete" asp-route-id="@course.Id"
                                      onsubmit="return confirm('Удалить курс @course.Title?');"
                                      class="d-inline">
                                    <button type="submit" class="btn btn-outline-danger btn-sm">
                                        <i class="bi bi-trash"></i> Удалить
                                    </button>
                                </form>
                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>