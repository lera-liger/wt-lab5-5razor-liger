@page
@model wt_lab5_5razor_liger.Pages.Courses.CreateModel

@{
    ViewData["Title"] = "Добавить курс";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">

            <div class="card shadow-sm rounded-4 border-0">
                <div class="card-body p-4">

                    <h2 class="mb-4 text-university">
                        <i class="bi bi-journal-plus"></i>
                        Добавление курса
                    </h2>

                    <form method="post">

                        <div class="mb-3">
                            <label asp-for="Course.Title" class="form-label"></label>
                            <input asp-for="Course.Title" class="form-control" />
                            <span asp-validation-for="Course.Title" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Course.Semester" class="form-label"></label>
                                <input asp-for="Course.Semester" class="form-control" type="number" min="1" max="4" />
                                <span asp-validation-for="Course.Semester" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Course.Hours" class="form-label"></label>
                                <input asp-for="Course.Hours" class="form-control" type="number" min="1" max="300" />
                                <span asp-validation-for="Course.Hours" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Course.TeacherId" class="form-label"></label>
                            <select asp-for="Course.TeacherId"
                                    asp-items="Model.TeachersList"
                                    class="form-select">
                                <option value="">-- Выберите преподавателя --</option>
                            </select>
                            <span asp-validation-for="Course.TeacherId" class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-lg"></i> Сохранить
                            </button>
                            <a asp-page="./Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Назад к списку
                            </a>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}